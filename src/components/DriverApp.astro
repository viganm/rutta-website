---
/**
 * Rutta Driver at a shop door: the app's own stop screen, delivery sheet and
 * undo toast, rebuilt in HTML from the real strings. src/scripts/driver.ts
 * plays it through, in step with the list beside it.
 */
import { copy, fill, type Lang } from '../i18n';
import { routes } from '../scripts/sim';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].driver;
const p = t.phone;

// A faint trace of Arben's route behind the phone, from the real geometry.
const line = routes[0]!.data.line;
let minX = Infinity;
let minY = Infinity;
let maxX = -Infinity;
let maxY = -Infinity;
for (let i = 0; i < line.length; i += 2) {
  minX = Math.min(minX, line[i]!);
  maxX = Math.max(maxX, line[i]!);
  minY = Math.min(minY, line[i + 1]!);
  maxY = Math.max(maxY, line[i + 1]!);
}
const scale = 560 / Math.max(maxX - minX, maxY - minY);
let trace = '';
for (let i = 0; i < line.length; i += 2) {
  trace += `${i ? 'L' : 'M'}${((line[i]! - minX) * scale + 20).toFixed(1)} ${((line[i + 1]! - minY) * scale + 20).toFixed(1)}`;
}
---

<section class="driver paper section" id="driver" aria-labelledby="driver-title">
  <div class="wrap driver__grid">
    <div class="driver__head">
      <h2 class="h2" id="driver-title">
        {t.title}
      </h2>
      <p class="lead">{t.lead}</p>
    </div>
    <div class="driver__copy">
      <ol class="driver__steps" data-driver-steps>
        {t.steps.map((step, i) => (
          <li>
            <button
              type="button"
              class="driver__step"
              data-step-index={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="driver__step-rail" aria-hidden="true">
                <i />
              </span>
              <span class="driver__step-title">{step.title}</span>
              <span class="driver__step-body">{step.body}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>

    <div class="driver__stage" aria-hidden="true">
      <svg class="driver__trace" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet">
        <path d={trace}></path>
      </svg>
      <div class="phone driver__phone" data-phone>
        <div class="phone__screen">
          <div class="phone__island"></div>
          <div class="phone__status">
            <span class="num">11:18</span>
            <svg viewBox="0 0 34 12" fill="currentColor">
              <rect x="0" y="7" width="3" height="5" rx="1"></rect>
              <rect x="5" y="5" width="3" height="7" rx="1"></rect>
              <rect x="10" y="2.5" width="3" height="9.5" rx="1"></rect>
              <rect x="15" y="0" width="3" height="12" rx="1"></rect>
              <rect
                x="22"
                y="1"
                width="11"
                height="10"
                rx="2.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
              ></rect>
              <rect x="23.8" y="2.8" width="6.4" height="6.4" rx="1.2"></rect>
            </svg>
          </div>

          <!-- The stop -->
          <div class="app" data-screen="stop">
            <div class="app__bar">
              <span class="app__back">
                <svg viewBox="0 0 16 16">
                  <path
                    d="M10 3.5 5.5 8l4.5 4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                {copy[lang].board.title}
              </span>
              <span class="app__title num">{fill(p.stop, { n: 9 })}</span>
              <span class="app__sync" data-sync>
                <svg viewBox="0 0 16 16">
                  <path
                    d="M4 11.5h7.5a3 3 0 0 0 .4-6 4 4 0 0 0-7.6-1A3.5 3.5 0 0 0 4 11.5z"
                    fill="currentColor"
                  ></path>
                </svg>
                <span data-sync-text>{p.synced}</span>
              </span>
            </div>
            <p class="app__name">{p.name}</p>
            <p class="app__sub">
              {p.town} · <span class="num">{p.due}</span>
            </p>
            <p class="app__dir">
              <svg viewBox="0 0 16 16">
                <path
                  d="M8 14.5S3 10 3 6.6a5 5 0 1 1 10 0C13 10 8 14.5 8 14.5zM8 8.4a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6z"
                  fill="currentColor"
                ></path>
              </svg>
              {p.directions}
            </p>
            <div class="app__door">
              <p class="app__label">{p.atTheDoor}</p>
              <p class="app__collect">
                <span>{p.collect}</span>
                <b class="num">{p.cash}</b>
              </p>
              <div class="app__chips">
                <span class="chip">
                  <svg viewBox="0 0 16 16">
                    <path
                      d="M2.5 5.5 8 2.5l5.5 3v5L8 13.5l-5.5-3zM2.5 5.5 8 8.5l5.5-3M8 8.5v5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                  {p.pallets}
                </span>
                <span class="chip">
                  <svg viewBox="0 0 16 16">
                    <path
                      d="M2 6h12v7H2zM2 6l1.5-3h9L14 6M6 9h4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linejoin="round"
                    ></path>
                  </svg>
                  {p.crates}
                </span>
              </div>
            </div>
            <div class="app__actions">
              <span class="app__action">
                <svg viewBox="0 0 16 16">
                  <path
                    d="M2.5 7.4 13.5 2.5 8.6 13.5 7.4 8.6z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                {p.navigate}
              </span>
              <span class="app__action">{p.fail}</span>
            </div>
            <div class="app__status" data-delivered>
              <span class="pill" data-tone="delivered">
                <svg viewBox="0 0 16 16">
                  <path
                    d="M3.5 8.5l3 3 6-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                {p.delivered}
              </span>
            </div>
            <div class="slab" data-slab>
              <span class="slab__fill" data-slab-fill></span>
              <span class="slab__thumb" data-slab-thumb>
                <svg viewBox="0 0 16 16">
                  <path
                    d="M6 3.5 10.5 8 6 12.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </span>
              <span class="slab__text" data-slab-text>
                {p.swipe}
              </span>
              <span class="slab__text slab__text--done" data-slab-done>
                {p.deliver}
              </span>
            </div>
          </div>

          <!-- The delivery sheet -->
          <div class="sheet" data-screen="deliver">
            <span class="sheet__grip"></span>
            <p class="sheet__title">{p.deliver}</p>
            <div class="sheet__row">
              <p class="sheet__label">{p.photo}</p>
              <div class="sheet__photo" data-photo>
                <svg viewBox="0 0 120 70" preserveAspectRatio="xMidYMid slice">
                  <rect width="120" height="70" fill="#C9D6CF"></rect>
                  <rect y="48" width="120" height="22" fill="#9FB1A7"></rect>
                  <g fill="#0F5C4A">
                    <rect x="30" y="30" width="26" height="18" rx="2"></rect>
                    <rect x="58" y="30" width="26" height="18" rx="2"></rect>
                    <rect x="44" y="12" width="26" height="18" rx="2"></rect>
                  </g>
                  <g fill="none" stroke="#DCEBE3" stroke-width="1.4">
                    <path d="M35 39h16M63 39h16M49 21h16"></path>
                  </g>
                </svg>
                <span class="sheet__flash" data-flash></span>
              </div>
              <p class="sheet__ok" data-photo-ok>
                <svg viewBox="0 0 16 16">
                  <path
                    d="M3.5 8.5l3 3 6-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                {p.photoTaken}
              </p>
            </div>
            <div class="sheet__row">
              <p class="sheet__label">{p.cashLabel}</p>
              <span class="sheet__choice" data-cash>
                {p.cashExact}
              </span>
            </div>
            <div class="sheet__row">
              <p class="sheet__label">{p.signature}</p>
              <div class="sheet__sign">
                <svg viewBox="0 0 200 60">
                  <path
                    data-signature
                    d="M14 40c8-18 14-26 18-22 4 5-10 26-4 27 7 1 13-24 20-23 6 1 0 20 6 20 5 0 9-12 15-12s2 11 8 11c7 0 10-17 17-17 6 0 1 14 7 14 8 0 14-10 22-12 7-2 12 2 20 0 9-2 15-8 22-10"
                    fill="none"
                    stroke="#121A17"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
                <span class="sheet__hint">{p.signHere}</span>
              </div>
            </div>
            <span class="sheet__confirm" data-confirm>
              {p.confirm}
            </span>
          </div>

          <!-- Five seconds to undo -->
          <div class="toast" data-toast>
            <span class="toast__ring">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" data-ring></circle>
              </svg>
              <b class="num" data-count>
                5
              </b>
            </span>
            <span class="toast__text">{p.done}</span>
            <span class="toast__undo">{p.undo}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .driver__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    grid-template-areas: 'head stage' 'steps stage';
    grid-template-rows: auto 1fr;
    column-gap: clamp(40px, 6vw, 96px);
    row-gap: 32px;
  }
  .driver__head {
    grid-area: head;
    display: grid;
    gap: 24px;
    align-self: end;
  }
  .driver__copy {
    grid-area: steps;
  }
  .driver__stage {
    grid-area: stage;
  }
  .driver__steps {
    display: grid;
    gap: 4px;
  }
  .driver__step {
    position: relative;
    display: grid;
    grid-template-columns: 3px 1fr;
    column-gap: 20px;
    row-gap: 4px;
    width: 100%;
    padding: 16px 16px 16px 0;
    border: 0;
    border-radius: 12px;
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--text);
  }
  .driver__step-rail {
    grid-row: span 2;
    position: relative;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .driver__step-rail i {
    position: absolute;
    inset: 0;
    background: var(--primary);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }
  .driver__step-title {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.012em;
    color: var(--text-3);
    transition: color 0.3s var(--ease-out);
  }
  .driver__step-body {
    color: var(--text-3);
    line-height: 1.5;
    max-width: 34em;
    transition: color 0.3s var(--ease-out);
  }
  .driver__step[aria-pressed='true'] .driver__step-title {
    color: var(--text);
  }
  .driver__step[aria-pressed='true'] .driver__step-body {
    color: var(--text-2);
  }
  .driver__step:hover .driver__step-title {
    color: var(--text);
  }

  .driver__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 720px;
  }
  .driver__trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .driver__trace path {
    fill: none;
    stroke: var(--r0);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.22;
  }
  .driver__phone {
    --pw: 330px;
  }

  /* ---------------------------------------------- the driver app inside */
  .app,
  .sheet {
    position: absolute;
    inset: 0;
  }
  .app {
    display: flex;
    flex-direction: column;
    padding: calc(var(--pw) * 0.13) 18px 18px;
    gap: 6px;
  }
  .app__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
    font-weight: 600;
    color: var(--primary);
  }
  .app__title {
    font-weight: 700;
  }
  .app__sync {
    justify-self: end;
  }
  .app__sync {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 24px;
    padding: 5px 9px;
    border-radius: 99px;
    background: #dcebe3;
    color: #0b4a3b;
    font-size: 0.82em;
    font-weight: 600;
  }
  .app__sync svg {
    width: 13px;
    height: 13px;
  }
  .app__name {
    font-size: 1.7em;
    line-height: 1.1;
    font-weight: 750;
    letter-spacing: -0.02em;
  }
  .app__sub {
    font-weight: 560;
    color: var(--text-2);
  }
  .app__dir {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-weight: 560;
  }
  .app__dir svg {
    width: 15px;
    height: 15px;
    color: var(--primary);
    flex: none;
  }
  .app__door {
    display: grid;
    gap: 10px;
    margin-top: 12px;
    padding: 14px;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 0 0 1px #d3dcd5 inset;
  }
  .app__label {
    font-size: 0.85em;
    font-weight: 650;
    color: var(--text-3);
  }
  .app__collect {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 12px;
    border-radius: 10px;
    background: #fdf0d5;
    color: #6b4100;
    font-weight: 600;
  }
  .app__collect b {
    font-size: 1.25em;
    font-weight: 750;
  }
  .app__chips {
    display: flex;
    gap: 6px;
  }
  .app__chips .chip {
    height: 28px;
    font-size: 0.85em;
    background: #eaf0eb;
    color: #3f4b45;
  }
  .app__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 12px;
  }
  .app__action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 46px;
    border-radius: 12px;
    box-shadow: 0 0 0 1.5px #d3dcd5 inset;
    background: var(--surface);
    font-weight: 650;
    font-size: 0.92em;
    color: var(--primary);
  }
  .app__action:last-child {
    color: #8f1c13;
  }
  .app__action svg {
    width: 15px;
    height: 15px;
  }
  .app__status {
    margin-top: 10px;
    opacity: 0;
  }
  .app__status .pill {
    height: 28px;
    padding: 0 12px;
    font-size: 0.9em;
  }

  .slab {
    position: relative;
    margin-top: auto;
    height: 58px;
    border-radius: 14px;
    background: var(--primary);
    color: #fff;
    overflow: hidden;
    font-weight: 750;
    font-size: 1.05em;
  }
  .slab__fill {
    position: absolute;
    inset: 0;
    background: #0b4a3b;
    transform-origin: left;
    transform: scaleX(0);
  }
  .slab__thumb svg {
    width: 20px;
    height: 20px;
  }
  .app__back {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .app__back svg {
    width: 16px;
    height: 16px;
  }
  .sheet__ok svg {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    vertical-align: -2px;
  }
  .slab__thumb {
    position: absolute;
    z-index: 1;
    top: 6px;
    left: 6px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.16);
    font-size: 1.6em;
    line-height: 1;
  }
  .slab__text {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-left: 40px;
  }
  .slab__text--done {
    padding-left: 0;
    opacity: 0;
  }

  .sheet {
    top: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 84%;
    padding: 10px 18px 18px;
    border-radius: 22px 22px 0 0;
    background: var(--surface);
    box-shadow: 0 -12px 40px -10px rgb(18 26 23 / 0.35);
    transform: translateY(105%);
  }
  .sheet__grip {
    align-self: center;
    width: 38px;
    height: 5px;
    border-radius: 3px;
    background: #d3dcd5;
  }
  .sheet__title {
    font-size: 1.35em;
    font-weight: 750;
  }
  .sheet__row {
    display: grid;
    gap: 6px;
  }
  .sheet__label {
    font-size: 0.85em;
    font-weight: 650;
    color: var(--text-3);
  }
  .sheet__photo {
    position: relative;
    height: 64px;
    border-radius: 10px;
    overflow: hidden;
    opacity: 0.25;
  }
  .sheet__photo svg {
    width: 100%;
    height: 100%;
  }
  .sheet__flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
  }
  .sheet__ok {
    font-size: 0.85em;
    font-weight: 600;
    color: var(--primary);
    opacity: 0;
  }
  .sheet__choice {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 10px;
    box-shadow: 0 0 0 1.5px #d3dcd5 inset;
    font-weight: 650;
    font-size: 0.95em;
  }
  .sheet__choice:global(.is-on) {
    box-shadow: 0 0 0 2px var(--primary) inset;
    background: #dcebe3;
    color: #0b4a3b;
  }
  .sheet__sign {
    position: relative;
    height: 72px;
    border-radius: 10px;
    background: #f7f9f7;
    box-shadow: 0 0 0 1px #d3dcd5 inset;
  }
  .sheet__sign svg {
    position: absolute;
    inset: 4px 10px 16px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
  }
  .sheet__hint {
    position: absolute;
    left: 10px;
    bottom: 5px;
    font-size: 0.7em;
    color: var(--text-3);
  }
  .sheet__confirm {
    display: grid;
    place-items: center;
    height: 54px;
    margin-top: auto;
    border-radius: 14px;
    background: var(--primary);
    color: #fff;
    font-weight: 750;
  }

  .toast {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 86px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border-radius: 14px;
    background: #121a17;
    color: #e7efea;
    font-size: 0.88em;
    font-weight: 560;
    box-shadow: 0 18px 30px -12px rgb(18 26 23 / 0.6);
    opacity: 0;
    transform: translateY(16px);
  }
  .toast__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
  }
  .toast__ring svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .toast__ring circle {
    fill: none;
    stroke: #7fd8b8;
    stroke-width: 2.4;
  }
  .toast__ring b {
    font-size: 0.85em;
  }
  .toast__text {
    flex: 1;
  }
  .toast__undo {
    font-weight: 750;
    color: #7fd8b8;
  }

  @media (max-width: 959px) {
    .driver__grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'stage' 'steps';
      grid-template-rows: auto;
    }
    .driver__stage {
      min-height: 0;
      padding-block: 24px;
    }
    .driver__phone {
      --pw: min(310px, 80vw);
    }
  }
</style>

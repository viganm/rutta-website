---
/**
 * Made for here, set as a map legend: each row shows the thing itself in the
 * apps' own components (the language switch, amounts as the apps format
 * them, the date stamp, the stop chips), over the Šar mountains' contours.
 */
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].local;
const phone = copy[lang].driver.phone;
const locale = lang === 'sq' ? 'sq-AL' : 'en-GB';
// Amounts as the apps format them: Intl, per company currency.
const money = (v: number, currency: string) =>
  new Intl.NumberFormat(locale, {
    style: 'currency',
    currency,
    minimumFractionDigits: currency === 'EUR' ? 2 : 0,
    maximumFractionDigits: currency === 'EUR' ? 2 : 0,
  }).format(v);
const amounts = [money(343, 'EUR'), money(4250, 'ALL'), money(2130, 'MKD'), money(3900, 'RSD')];
const icon = {
  clock: '<circle cx="8" cy="8" r="6.2"/><path d="M8 4.8V8l2.2 1.4"/>',
  cash: '<rect x="1.8" y="4" width="12.4" height="8" rx="1.6"/><circle cx="8" cy="8" r="1.8"/>',
  crate: '<path d="M2 6h12v7H2zM2 6l1.5-3h9L14 6M6 9h4"/>',
  pallet: '<path d="M2.5 5.5 8 2.5l5.5 3v5L8 13.5l-5.5-3zM2.5 5.5 8 8.5l5.5-3M8 8.5v5"/>',
};
---

<section class="local paper section" aria-labelledby="local-title" data-local>
  <canvas class="local__relief" data-map aria-hidden="true"></canvas>
  <div class="wrap local__grid">
    <h2 class="h2" id="local-title">
      {t.title}
    </h2>
    <dl class="legend-list">
      <div class="legend-list__row">
        <dt>
          <span class="visually-hidden">{t.items[0]!.key}</span>
          <span class="toggle" aria-hidden="true">
            <b>SQ</b>
            <span>EN</span>
          </span>
          <span class="toggle toggle--en" aria-hidden="true">
            <span>SQ</span>
            <b>EN</b>
          </span>
        </dt>
        <dd>{t.items[0]!.body}</dd>
      </div>
      <div class="legend-list__row">
        <dt>
          <span class="visually-hidden">{t.items[1]!.key}</span>
          <span class="chips" aria-hidden="true">
            {amounts.map((a) => (
              <span class="chip chip--cash num">{a}</span>
            ))}
          </span>
        </dt>
        <dd>{t.items[1]!.body}</dd>
      </div>
      <div class="legend-list__row">
        <dt>
          <span class="chip chip--stamp num">
            <svg viewBox="0 0 16 16" aria-hidden="true" set:html={icon.clock} />
            {t.items[2]!.key}
          </span>
        </dt>
        <dd>{t.items[2]!.body}</dd>
      </div>
      <div class="legend-list__row">
        <dt>
          <span class="visually-hidden">{t.items[3]!.key}</span>
          <span class="chips" aria-hidden="true">
            <span class="chip chip--cash num">
              <svg viewBox="0 0 16 16" set:html={icon.cash} />
              {phone.cash}
            </span>
            <span class="chip num">
              <svg viewBox="0 0 16 16" set:html={icon.pallet} />
              {phone.pallets}
            </span>
            <span class="chip num">
              <svg viewBox="0 0 16 16" set:html={icon.crate} />
              {phone.crates}
            </span>
          </span>
        </dt>
        <dd>{t.items[3]!.body}</dd>
      </div>
      <div class="legend-list__row">
        <dt>
          <svg class="legend-list__sealed" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" stroke-dasharray="3.4 2.6"></rect>
            <path d="M7 17 17 7M7 12.5 12.5 7M11.5 17 17 11.5"></path>
          </svg>
          <span class="legend-list__key">{t.items[4]!.key}</span>
        </dt>
        <dd>{t.items[4]!.body}</dd>
      </div>
      <div class="legend-list__row">
        <dt>
          <span class="visually-hidden">{t.items[5]!.key}</span>
          <span class="swatches" aria-hidden="true">
            <span class="swatch swatch--paper">Aa</span>
            <span class="swatch swatch--night">Aa</span>
            <span class="swatch swatch--contrast">Aa</span>
          </span>
          <span class="legend-list__key" aria-hidden="true">
            {t.items[5]!.key}
          </span>
        </dt>
        <dd>{t.items[5]!.body}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .local {
    position: relative;
    padding-top: clamp(48px, 4vw, 80px);
    overflow: hidden;
  }
  .local__relief {
    position: absolute;
    left: 0;
    top: 0;
    width: 52%;
    height: 100%;
    max-width: none;
    opacity: 0.9;
    mask-image: radial-gradient(70% 60% at 40% 62%, #000 30%, transparent 75%);
  }
  .local__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .local .h2 {
    position: sticky;
    top: calc(var(--nav-h) + 48px);
  }
  .legend-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .legend-list__row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 12px 32px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  dd {
    margin: 0;
    color: var(--text-2);
  }
  .legend-list__key {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chip--stamp {
    height: 32px;
    padding: 0 12px;
    font-size: 0.9375rem;
    font-weight: 620;
    color: var(--text);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line) inset;
  }
  .toggle {
    display: inline-flex;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.8125rem;
    font-weight: 620;
  }
  .toggle > * {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 28px;
    border-radius: 7px;
    color: var(--text-3);
  }
  .toggle b {
    background: var(--primary);
    color: var(--on-primary);
  }
  .legend-list__sealed {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--primary);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .swatches {
    display: flex;
    gap: 6px;
  }
  .swatch {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .swatch--paper {
    background: #f1f4f0;
    color: #121a17;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .swatch--night {
    background: #0e1a17;
    color: #e7efea;
  }
  .swatch--contrast {
    background: #ffffff;
    color: #050807;
    box-shadow: inset 0 0 0 2px #050807;
  }
  @media (max-width: 899px) {
    .local__relief {
      width: 100%;
      height: 420px;
      mask-image: linear-gradient(#000 40%, transparent);
    }
    .local__grid {
      grid-template-columns: 1fr;
    }
    .local .h2 {
      position: static;
    }
    .legend-list__row {
      grid-template-columns: 1fr;
    }
  }
</style>
